    .banpresto-page {
      padding-top: calc(var(--nav-h) + 2rem);
      padding-bottom: 5rem;
      min-height: 100vh;
      background: var(--bg);
    }

    .banpresto-page .tool-header {
      margin-bottom: 2rem;
    }

    .banpresto-page .tool-title {
      font-size: 2.25rem;
      font-weight: 800;
      color: var(--text);
