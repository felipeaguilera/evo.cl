          });
          await navigator.clipboard.write([clipboardItem]);
          showToast(`¡Ficha de ${item.jan || item.itemNo || item.query} copiada en Español!`);
        } catch (e) {
          await navigator.clipboard.writeText(textContent);
          showToast(`Ficha copiada en texto plano`);
        }
      } else {
        await navigator.clipboard.writeText(textContent);
        showToast(`Ficha copiada en texto plano`);
      }
    }

    // HELPER: FETCH IMAGE BLOB SAFELY WITH SERVER PROXY FALLBACK
    async function fetchImageBlob(imgUrl) {
      if (!imgUrl) return null;

      try {
        const res = await fetch(imgUrl);
        if (res.ok) {
          const blob = await res.blob();
          if (blob.size > 200) return blob;
        }
      } catch (e) {
        // Direct fetch failed (CORS)
      }

      const proxyUrls = [
        `/.netlify/functions/banpresto-lookup?img=${encodeURIComponent(imgUrl)}`,
        `/api/banpresto-lookup?img=${encodeURIComponent(imgUrl)}`
      ];

      for (const purl of proxyUrls) {
        try {
          const res = await fetch(purl);
          if (res.ok) {
            const blob = await res.blob();
            if (blob.size > 200) return blob;
          }
        } catch (err) {
          console.warn('Proxy fetch failed:', err);
        }
      }

      return null;
    }

    // DOWNLOAD SINGLE PRODUCT PHOTOS AS ZIP
    async function downloadSingleProductZip(item) {
      if (typeof JSZip === 'undefined') {
        alert('Librería ZIP cargando... Por favor reintenta en 1 segundo.');
        return;
      }

      const gallery = (item.gallery && item.gallery.length > 0) ? item.gallery : (item.image ? [item.image] : []);
      if (gallery.length === 0) {
        alert('No hay fotografías disponibles para este producto.');
        return;
      }

      const cleanCode = (item.jan || item.itemNo || item.query || 'banpresto').replace(/[^a-zA-Z0-9_-]/g, '_');
      showToast(`Descargando ${gallery.length} fotos de ${cleanCode}...`);

      const zip = new JSZip();
      let savedPhotos = 0;

      for (let idx = 0; idx < gallery.length; idx++) {
        const imgUrl = gallery[idx];
        try {
          const blob = await fetchImageBlob(imgUrl);
          if (blob) {
            const ext = imgUrl.includes('.png') ? 'png' : 'jpg';
            zip.file(`${cleanCode}_${String(idx + 1).padStart(2, '0')}.${ext}`, blob);
            savedPhotos++;
          }
        } catch(e) {
          console.warn('Error downloading single photo:', e);
        }
      }

      if (savedPhotos === 0) {
        alert('No fue posible descargar las imágenes de este producto.');
        return;
      }

      const content = await zip.generateAsync({ type: 'blob' });
      const url = URL.createObjectURL(content);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `banpresto-${cleanCode}-photos.zip`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast(`ZIP descargado: ${savedPhotos} fotos de ${cleanCode}`);
    }

    // FETCH SINGLE QUERY WITH LOCAL CACHE + TIMEOUT
    async function fetchFigureWithRetry(queryStr, forceRefresh = false, retryCount = 1) {
      if (!forceRefresh) {
        const cached = getFromLocalCatalog(queryStr);
        if (cached && cached.status === 'found') {
          // Extract input price if present
          let inputPrice = '';
          if (queryStr.includes('|')) {
            const parts = queryStr.split('|').map(p => p.trim());
            if (parts.length >= 3) inputPrice = parts[2];
          } else if (queryStr.includes('\t')) {
            const parts = queryStr.split('\t').map(p => p.trim());
            if (parts.length >= 3) inputPrice = parts[2];
          }
          const finalPrice = inputPrice ? (inputPrice.startsWith('$') ? inputPrice : `$${parseInt(inputPrice.replace(/\D/g, ''), 10).toLocaleString('es-CL')}`) : (cached.price || '');
          return { ...cached, price: finalPrice, query: queryStr, source: cached.source || 'local_index', fromCache: true };
        }
      }

      const endpoints = ['/.netlify/functions/banpresto-lookup', '/api/banpresto-lookup'];
      
      for (const ep of endpoints) {
        try {
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 9000);

          const res = await fetch(ep, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: queryStr, forceRefresh }),
            signal: controller.signal
          });
          clearTimeout(timeoutId);
          
          if (res.ok) {
            const data = await res.json();
            if (data.items && data.items.length > 0) {
              const item = data.items[0];
              saveToLocalCatalog(item);
              return item;
            }
          }
        } catch (e) {
          console.warn(`[Banpresto Tool] Error en ${ep} para ${queryStr}:`, e.message);
        }
      }

      const parts = queryStr.includes('|') ? queryStr.split('|').map(s => s.trim()) : queryStr.split('\t').map(s => s.trim());
      const jan = /^\d{12,13}$/.test(parts[0]) ? parts[0] : '';
      const itemNo = jan.length === 13 ? jan.substring(7, 12) : '';
      const title = parts[1] || queryStr;
      const price = parts[2] || '';

      return {
        query: queryStr,
        jan,
        itemNo,
        title,
        price,
        franchise: 'Banpresto',
        line: 'Banpresto',
        image: '',
        gallery: [],
        source: 'not_found',
        status: 'not_found',
        diagnosis: 'Figura no indexada en catálogo de distribuidores activos'
      };
    }

    // REFRESH SINGLE CARD INDIVIDUALLY ON DEMAND
    async function refreshSingleProduct(item, cardElem) {
      const q = item.query || item.jan || item.title;
      showToast(`Refrescando datos desde la red para ${item.jan || item.title}...`);
      
      const refreshBtn = cardElem.querySelector('.btn-refresh-card');
      if (refreshBtn) {
        refreshBtn.classList.add('loading');
        refreshBtn.innerHTML = '<i class="ph ph-spinner ph-spin"></i> <span>Actualizando...</span>';
      }

      const updated = await fetchFigureWithRetry(q, true); // forceRefresh = true

      const idx = productsList.findIndex(p => p.query === item.query || (p.jan && p.jan === item.jan));
      if (idx !== -1) {
        productsList[idx] = updated;
      }

      saveToLocalCatalog(updated);
      renderResults();
      showToast(`¡Ficha de ${updated.title} actualizada exitosamente!`);
    }

    // BATCH QUEUE RUNNER
    async function runBatch() {
      const lines = getCleanLines();
      if (lines.length === 0) {
        alert('Por favor ingresa al menos una figura de Banpresto (JAN o Título).');
        return;
      }

      isRunning = true;
      isPaused = false;
      btnStart.disabled = true;
      btnPause.disabled = false;
      btnReset.disabled = false;
      codesInput.disabled = true;
      btnLoadSample.disabled = true;
      btnClearInput.disabled = true;
      reportSummaryCard.style.display = 'none';

      statusDot.className = 'status-dot active';
      statusText.textContent = 'Procesando lista...';
      progressBarFill.style.width = '0%';
      progressPercent.textContent = '0%';

      productsList = [];
      if (statTotalBadge) statTotalBadge.textContent = `(${lines.length} figuras)`;
      if (statLocal) statLocal.textContent = '0';
      statDistritoMax.textContent = '0';
      statLittleBuddy.textContent = '0';
      statNotFound.textContent = '0';
      renderResults();

      const pacing = batchPacing ? batchPacing.value : 'fast';
      let chunkSize = 3;
      let delayMs = 200;

      if (pacing === 'moderate') {
        chunkSize = 2;
        delayMs = 400;
      } else if (pacing === 'safe') {
        chunkSize = 1;
        delayMs = 800;
      }

      let completed = 0;

      for (let i = 0; i < lines.length; i += chunkSize) {
        if (!isRunning) break;

        while (isPaused) {
          await new Promise(r => setTimeout(r, 200));
          if (!isRunning) break;
        }

        const chunk = lines.slice(i, i + chunkSize);
        statusText.textContent = `⚡ Procesando ${Math.min(i + chunkSize, lines.length)} de ${lines.length}...`;

        try {
          const results = await Promise.all(chunk.map(line => fetchFigureWithRetry(line)));

          for (const item of results) {
            productsList.push(item);
            completed++;
          }
        } catch(batchErr) {
          console.warn('Batch chunk error:', batchErr);
          chunk.forEach(q => {
            const parts = q.includes('|') ? q.split('|').map(s => s.trim()) : q.split('\t').map(s => s.trim());
            productsList.push({
              query: q,
              jan: parts[0] || '',
              title: parts[1] || q,
              price: parts[2] || '',
              franchise: 'Banpresto',
              line: 'Banpresto',
              image: '',
              gallery: [],
              source: 'not_found',
              status: 'not_found',
              diagnosis: 'Error de conexión'
            });
            completed++;
          });
        }

        const pct = Math.round((completed / lines.length) * 100);
        progressPercent.textContent = `${pct}%`;
        progressBarFill.style.width = `${pct}%`;

        const localCount = productsList.filter(p => p.fromCache || p.source === 'local_index').length;
        const distritoCount = productsList.filter(p => p.source === 'distritomax').length;
        const buddyCount = productsList.filter(p => p.source === 'littlebuddytoys' || p.source === 'upc_database').length;
        const notFoundCount = productsList.filter(p => p.status !== 'found').length;

        if (statLocal) statLocal.textContent = localCount;
        statDistritoMax.textContent = distritoCount;
        statLittleBuddy.textContent = buddyCount;
        statNotFound.textContent = notFoundCount;

        try {
          renderResults();
        } catch(rErr) {
          console.warn('Render error:', rErr);
        }

        if (delayMs > 0 && i + chunkSize < lines.length) {
          await new Promise(r => setTimeout(r, delayMs));
        }
      }

      isRunning = false;
      btnStart.disabled = false;
      btnPause.disabled = true;
      codesInput.disabled = false;
      btnLoadSample.disabled = false;
      btnClearInput.disabled = false;

      statusDot.className = 'status-dot';
      statusText.textContent = 'Búsqueda completada';
      showToast(`Completado: ${productsList.length} figuras procesadas`);

      showBatchSummary();
    }

    btnStart.addEventListener('click', runBatch);

    btnPause.addEventListener('click', () => {
      if (!isRunning) return;
      isPaused = !isPaused;
      btnPause.innerHTML = isPaused
        ? '<i class="ph ph-play" aria-hidden="true"></i><span>Reanudar</span>'
        : '<i class="ph ph-pause" aria-hidden="true"></i><span>Pausar</span>';
      statusText.textContent = isPaused ? 'Pausado' : 'Procesando lista...';
    });

    btnReset.addEventListener('click', () => {
      isRunning = false;
      isPaused = false;
      productsList = [];
      expandedProductIds.clear();
      btnStart.disabled = false;
      btnPause.disabled = true;
      btnReset.disabled = true;
      codesInput.disabled = false;
      btnLoadSample.disabled = false;
      btnClearInput.disabled = false;
      reportSummaryCard.style.display = 'none';
      if (viewModeTabsBar) viewModeTabsBar.style.display = 'none';

      progressBarFill.style.width = '0%';
      progressPercent.textContent = '0%';
      if (statTotalBadge) statTotalBadge.textContent = '(0 figuras)';
      if (statLocal) statLocal.textContent = '0';
      statDistritoMax.textContent = '0';
      statLittleBuddy.textContent = '0';
      statNotFound.textContent = '0';
      statusDot.className = 'status-dot';
      statusText.textContent = 'Listo para iniciar';

      renderResults();
    });

    // VIEW MODE TABS LOGIC
    const resultsToolbarElem = document.querySelector('.results-toolbar');

    if (tabViewCards && tabViewCollections) {
      tabViewCards.addEventListener('click', () => {
        tabViewCards.classList.add('active');
        tabViewCollections.classList.remove('active');
        reportSummaryCard.style.display = 'none';
        if (resultsToolbarElem) resultsToolbarElem.style.display = 'flex';
        if (productCardsList) productCardsList.style.display = 'flex';
        renderResults();
      });

      tabViewCollections.addEventListener('click', () => {
        tabViewCollections.classList.add('active');
        tabViewCards.classList.remove('active');
        reportSummaryCard.style.display = 'block';
        if (resultsToolbarElem) resultsToolbarElem.style.display = 'none';
        if (productCardsList) productCardsList.style.display = 'none';
        if (emptyState) emptyState.style.display = 'none';
      });
    }

    // POST BATCH REPORT SUMMARY (FRANCHISES BREAKDOWN)
    function showBatchSummary() {
      if (productsList.length === 0) return;

      const total = productsList.length;
      const foundItems = productsList.filter(p => p.status === 'found');
      const totalFound = foundItems.length;

      reportSummarySubtitle.textContent = `Se identificaron ${totalFound} de ${total} productos (${Math.round((totalFound/total)*100)}%). Haz clic en una franquicia para filtrar.`;

      const collectionsMap = {};
      foundItems.forEach(item => {
        const f = item.franchise || 'Banpresto';
        if (!collectionsMap[f]) {
          collectionsMap[f] = [];
        }
        collectionsMap[f].push(item);
      });

      const totalCollections = Object.keys(collectionsMap).length;
      if (tabCollectionsLabel) {
        tabCollectionsLabel.textContent = `Franquicias (${totalCollections})`;
      }
      if (viewModeTabsBar) {
        viewModeTabsBar.style.display = 'flex';
      }

      let collectionsHtml = '';
      const sortedEntries = Object.entries(collectionsMap).sort((a, b) => b[1].length - a[1].length);

      for (const [fName, items] of sortedEntries) {
        const linesList = Array.from(new Set(items.map(it => it.line).filter(Boolean)));
        const linesStr = linesList.length > 0 ? `Líneas: ${linesList.join(', ')}` : `${items.length} ${items.length === 1 ? 'figura' : 'figuras'}`;

        let thumbsHtml = '';
        items.slice(0, 6).forEach(it => {
          const src = it.image || '/assets/no-picture.svg';
          thumbsHtml += `
            <div style="width:34px; height:34px; min-width:34px; aspect-ratio:1/1; background:#fff; border:1px solid var(--border); border-radius:4px; padding:2px; display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0;">
              <img src="${escapeAttr(src)}" alt="" style="width:100%; height:100%; object-fit:contain; display:block;" onerror="this.src='/assets/no-picture.svg'">
            </div>
          `;
        });

        collectionsHtml += `
          <div class="collection-card" data-lic="${escapeAttr(fName)}" style="cursor:pointer;" title="Clic para filtrar por ${escapeAttr(fName)}">
            <div class="collection-card-header">
              <span class="collection-name">${escapeHtml(fName)}</span>
              <span class="collection-badge">${items.length}</span>
            </div>
            <div style="display:flex; gap:6px; overflow-x:auto; padding-bottom:2px; margin:4px 0;">
              ${thumbsHtml}
            </div>
            <span style="font-family:'IBM Plex Mono',monospace; font-size:0.7rem; color:var(--text-3);">${escapeHtml(linesStr)}</span>
          </div>
        `;
      }

      reportCollectionsGrid.innerHTML = collectionsHtml || '<p style="color:var(--text-3); font-size:0.84rem;">Sin figuras encontradas en este lote.</p>';
      
      reportCollectionsGrid.querySelectorAll('.collection-card').forEach(card => {
        card.addEventListener('click', () => {
          const lic = card.getAttribute('data-lic') || '';
          filterSearch.value = lic;
          if (tabViewCards && tabViewCollections) {
            tabViewCards.classList.add('active');
            tabViewCollections.classList.remove('active');
            reportSummaryCard.style.display = 'none';
            if (productCardsList) productCardsList.style.display = 'flex';
          }
          renderResults();
          showToast(`Filtrando por franquicia: ${lic}`);
        });
      });

      if (tabViewCards && tabViewCollections) {
        tabViewCards.classList.add('active');
        tabViewCollections.classList.remove('active');
        reportSummaryCard.style.display = 'none';
        if (productCardsList) productCardsList.style.display = 'flex';
      }
    }

    // FILTERING
    function getFilteredProducts() {
      const q = filterSearch.value.trim().toLowerCase();
      const st = filterStatus.value;

      return productsList.filter(item => {
        if (st === 'found' && item.status !== 'found') return false;
        if (st === 'not_found' && item.status === 'found') return false;

        if (!q) return true;
        const haystack = `${item.query || ''} ${item.jan || ''} ${item.itemNo || ''} ${item.title || ''} ${item.franchise || ''} ${item.line || ''} ${item.character || ''} ${item.price || ''} ${item.diagnosis || ''}`.toLowerCase();
        return haystack.includes(q);
      });
    }

    filterSearch.addEventListener('input', renderResults);
    filterStatus.addEventListener('change', renderResults);

    function renderResults() {
      const filtered = getFilteredProducts();

      if (productsList.length === 0) {
        emptyState.style.display = 'block';
        productCardsList.style.display = 'none';
        return;
      }

      emptyState.style.display = 'none';
      productCardsList.style.display = 'flex';
      renderProductCards(filtered);
    }

    // =======================================================
    // 2-STAGE PRODUCT CARDS RENDERER (DEFAULT GALLERY + COLLAPSIBLE FICHA)
    // =======================================================
    function renderProductCards(items) {
      if (!productCardsList) return;
      productCardsList.innerHTML = '';
      
      if (items.length === 0) {
        productCardsList.innerHTML = `<div class="panel-card" style="text-align:center; padding:2.5rem; color:var(--text-3); width:100%;">No hay coincidencias con el filtro aplicado</div>`;
        return;
