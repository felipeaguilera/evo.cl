    // EXPORT 1: COPY RICH HTML TABLE DIRECTLY TO CLIPBOARD
    async function copyTableHtml() {
      const foundItems = productsList.filter(p => p.status === 'found');
      if (foundItems.length === 0) {
        alert('No hay figuras encontradas para copiar.');
        return;
      }

      let html = `<table border="1" style="border-collapse:collapse; font-family:sans-serif; font-size:13px; width:100%;">
        <thead>
          <tr style="background:#f1f5f9; text-align:left;">
            <th style="padding:8px;">Foto</th>
            <th style="padding:8px;">Código JAN</th>
            <th style="padding:8px;">Item No</th>
            <th style="padding:8px;">Título Oficial</th>
            <th style="padding:8px;">Franquicia</th>
            <th style="padding:8px;">Línea</th>
            <th style="padding:8px;">Personaje</th>
            <th style="padding:8px; text-align:right;">Precio PVP</th>
            <th style="padding:8px;">Fuente</th>
          </tr>
        </thead>
        <tbody>`;

      let tsv = "Foto\tJAN\tItemNo\tTítulo\tFranquicia\tLínea\tPersonaje\tPVP\tFuente\n";

      foundItems.forEach(item => {
        const imgTag = item.image ? `<img src="${item.image}" width="40" height="40" style="object-fit:contain; vertical-align:middle;" />` : '';
        html += `<tr>
          <td style="padding:6px; text-align:center;">${imgTag}</td>
          <td style="padding:6px; font-weight:bold; font-family:monospace;">${escapeHtml(item.jan || item.query)}</td>
          <td style="padding:6px; font-family:monospace;">${escapeHtml(item.itemNo || '—')}</td>
          <td style="padding:6px; font-weight:bold;">${escapeHtml(item.title || '')}</td>
          <td style="padding:6px;">${escapeHtml(item.franchise || '—')}</td>
          <td style="padding:6px;">${escapeHtml(item.line || '—')}</td>
          <td style="padding:6px;">${escapeHtml(item.character || '—')}</td>
          <td style="padding:6px; text-align:right; font-weight:bold;">${escapeHtml(item.price || '—')}</td>
          <td style="padding:6px;">${escapeHtml(item.source === 'distritomax' ? 'DistritoMax' : item.source === 'littlebuddytoys' ? 'Little Buddy' : 'UPC Index')}</td>
        </tr>`;

        tsv += `${item.image || ''}\t${item.jan || item.query}\t${item.itemNo || ''}\t${item.title || ''}\t${item.franchise || ''}\t${item.line || ''}\t${item.character || ''}\t${item.price || ''}\t${item.source}\n`;
      });

      html += `</tbody></table>`;

      try {
        const blobHtml = new Blob([html], { type: 'text/html' });
        const blobText = new Blob([tsv], { type: 'text/plain' });
        const clipboardItem = new ClipboardItem({
          'text/html': blobHtml,
          'text/plain': blobText
        });
        await navigator.clipboard.write([clipboardItem]);
        showToast('¡Tabla copiada! Pégala con Ctrl+V directo en Google Sheets o Excel');
      } catch (e) {
        await navigator.clipboard.writeText(tsv);
        showToast('Datos copiados en formato tabla (TSV) para pegar directo en Sheets');
      }
    }

    btnCopyHtmlTable.addEventListener('click', copyTableHtml);
    btnReportCopyHtml.addEventListener('click', copyTableHtml);

    // EXPORT 2: FULL BATCH ZIP ARCHIVE OF IMAGES
    async function exportImagesZip() {
      if (typeof JSZip === 'undefined') {
        alert('Librería ZIP cargando... Por favor intenta en 2 segundos.');
        return;
      }

      const itemsWithImages = productsList.filter(p => (p.gallery && p.gallery.length > 0) || p.image);
      if (itemsWithImages.length === 0) {
        alert('No hay imágenes disponibles para empaquetar.');
        return;
      }

      zipProgressModal.style.display = 'flex';
      zipProgressFill.style.width = '0%';
      zipProgressText.textContent = 'Iniciando descarga de fotografías del lote...';

      const zip = new JSZip();
      let totalImages = 0;
      itemsWithImages.forEach(p => {
        const g = (p.gallery && p.gallery.length > 0) ? p.gallery : (p.image ? [p.image] : []);
        totalImages += g.length;
      });

      let downloadedCount = 0;

      for (const item of itemsWithImages) {
        const cleanCode = (item.jan || item.itemNo || item.query || 'banpresto').replace(/[^a-zA-Z0-9_-]/g, '_');
        const gallery = (item.gallery && item.gallery.length > 0) ? item.gallery : (item.image ? [item.image] : []);

        for (let idx = 0; idx < gallery.length; idx++) {
          const imgUrl = gallery[idx];
          try {
            const blob = await fetchImageBlob(imgUrl);
            if (blob) {
              const ext = imgUrl.includes('.png') ? 'png' : 'jpg';
              const filename = `${cleanCode}_${String(idx + 1).padStart(2, '0')}.${ext}`;
              zip.file(filename, blob);
              downloadedCount++;
            }
          } catch (e) {
            console.warn(`Error downloading image ${imgUrl}:`, e);
          }

          const pct = Math.round((downloadedCount / totalImages) * 100);
          zipProgressFill.style.width = `${pct}%`;
          zipProgressText.textContent = `Descargando imagen ${downloadedCount} de ${totalImages} (${pct}%)...`;
        }
      }

      if (downloadedCount === 0) {
        zipProgressModal.style.display = 'none';
        alert('No fue posible descargar imágenes del lote.');
        return;
      }

      zipProgressText.textContent = 'Comprimiendo archivo ZIP...';
      const content = await zip.generateAsync({ type: 'blob' });
      const url = URL.createObjectURL(content);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `banpresto-photos-jan-${new Date().toISOString().slice(0, 10)}.zip`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      zipProgressModal.style.display = 'none';
      showToast(`ZIP descargado con ${downloadedCount} fotos del lote`);
    }

    btnExportZip.addEventListener('click', exportImagesZip);
    btnReportExportZip.addEventListener('click', exportImagesZip);

    // EXPORT 3: GENERAL CSV
    function exportGeneralCsv() {
      if (productsList.length === 0) {
        alert('No hay productos para exportar.');
        return;
      }

      const headers = ['Query', 'JAN', 'ItemNo', 'Title', 'Franchise', 'Line', 'Character', 'Price_PVP', 'Source', 'Status', 'Diagnosis', 'Description_ES', 'Description_EN', 'Gallery_URLs', 'MainImageURL', 'SourceLink'];
      const rows = productsList.map(p => [
        `"${(p.query || '').replace(/"/g, '""')}"`,
        `"${(p.jan || '').replace(/"/g, '""')}"`,
        `"${(p.itemNo || '').replace(/"/g, '""')}"`,
        `"${(p.title || '').replace(/"/g, '""')}"`,
        `"${(p.franchise || '').replace(/"/g, '""')}"`,
        `"${(p.line || '').replace(/"/g, '""')}"`,
        `"${(p.character || '').replace(/"/g, '""')}"`,
        `"${(p.price || '').replace(/"/g, '""')}"`,
        `"${(p.source || '').replace(/"/g, '""')}"`,
        `"${(p.status || '').replace(/"/g, '""')}"`,
        `"${(p.diagnosis || '').replace(/"/g, '""')}"`,
        `"${(p.description_es || '').replace(/"/g, '""')}"`,
        `"${(p.description || '').replace(/"/g, '""')}"`,
        `"${((p.gallery && p.gallery.length > 0) ? p.gallery.join(' | ') : (p.image || '')).replace(/"/g, '""')}"`,
        `"${(p.image || '').replace(/"/g, '""')}"`,
        `"${(p.link || '').replace(/"/g, '""')}"`
      ]);

      const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\r\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `banpresto-catalog-general-${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('Archivo CSV General exportado');
    }

    btnExportCsv.addEventListener('click', exportGeneralCsv);
    btnReportExportCsv.addEventListener('click', exportGeneralCsv);

    // INITIALIZE
    updateInputCount();
    updateLocalCatalogBadge();
  </script>
</Base>

