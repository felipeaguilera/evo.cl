    // POST BATCH REPORT SUMMARY
    function showBatchSummary() {
      if (productsList.length === 0) return;

      const total = productsList.length;
      const foundItems = productsList.filter(p => p.status === 'found');
      const totalFound = foundItems.length;

      reportSummarySubtitle.textContent = `Se identificaron ${totalFound} de ${total} productos (${Math.round((totalFound/total)*100)}%). Haz clic en una colección para filtrar.`;

      const collectionsMap = {};
      foundItems.forEach(item => {
        const lic = item.license || item.fandom || 'Otras Figuras';
        if (!collectionsMap[lic]) {
          collectionsMap[lic] = [];
        }
        collectionsMap[lic].push(item);
      });

      const totalCollections = Object.keys(collectionsMap).length;
      if (tabCollectionsLabel) {
        tabCollectionsLabel.textContent = `Colecciones (${totalCollections})`;
      }
      if (viewModeTabsBar) {
        viewModeTabsBar.style.display = 'flex';
      }

      let collectionsHtml = '';
      const sortedEntries = Object.entries(collectionsMap).sort((a, b) => b[1].length - a[1].length);

      for (const [licName, items] of sortedEntries) {
        const boxNumbers = items.map(it => it.boxNumber).filter(Boolean);
        const boxesStr = boxNumbers.length > 0 ? `Cajas: ${boxNumbers.join(', ')}` : `${items.length} ${items.length === 1 ? 'figura' : 'figuras'}`;

        let thumbsHtml = '';
        items.slice(0, 6).forEach(it => {
          const src = it.image || '/assets/no-picture.svg';
          thumbsHtml += `
            <div style="width:34px; height:34px; min-width:34px; aspect-ratio:1/1; background:#fff; border:1px solid var(--border); border-radius:4px; padding:2px; display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0;">
              <img src="${escapeAttr(src)}" alt="" style="width:100%; height:100%; object-fit:contain; display:block;" onerror="this.src='/assets/no-picture.svg'">
            </div>
          `;
        });

        collectionsHtml += `
          <div class="collection-card" data-lic="${escapeAttr(licName)}" style="cursor:pointer;" title="Clic para filtrar por ${escapeAttr(licName)}">
            <div class="collection-card-header">
              <span class="collection-name">${escapeHtml(licName)}</span>
              <span class="collection-badge">${items.length}</span>
            </div>
            <div style="display:flex; gap:6px; overflow-x:auto; padding-bottom:2px; margin:4px 0;">
              ${thumbsHtml}
            </div>
            <span style="font-family:'IBM Plex Mono',monospace; font-size:0.7rem; color:var(--text-3);">${escapeHtml(boxesStr)}</span>
          </div>
        `;
      }

      reportCollectionsGrid.innerHTML = collectionsHtml || '<p style="color:var(--text-3); font-size:0.84rem;">Sin figuras encontradas en este lote.</p>';
      
      // Filter click on collections: switches to cards list and applies filter
      reportCollectionsGrid.querySelectorAll('.collection-card').forEach(card => {
        card.addEventListener('click', () => {
          const lic = card.getAttribute('data-lic') || '';
          filterSearch.value = lic;
          if (tabViewCards && tabViewCollections) {
            tabViewCards.classList.add('active');
            tabViewCollections.classList.remove('active');
            reportSummaryCard.style.display = 'none';
            if (productCardsList) productCardsList.style.display = 'flex';
          }
          renderResults();
          showToast(`Filtrando por colección: ${lic}`);
        });
      });

      // Keep default tab as Cards View so results list is immediately visible
      if (tabViewCards && tabViewCollections) {
        tabViewCards.classList.add('active');
        tabViewCollections.classList.remove('active');
        reportSummaryCard.style.display = 'none';
        if (productCardsList) productCardsList.style.display = 'flex';
      }
    }

    // FILTERING
    function getFilteredProducts() {
      const q = filterSearch.value.trim().toLowerCase();
      const st = filterStatus.value;

      return productsList.filter(item => {
        if (st === 'found' && item.status !== 'found') return false;
        if (st === 'not_found' && item.status === 'found') return false;

        if (!q) return true;
        const haystack = `${item.query} ${item.upc || ''} ${item.sku || ''} ${item.title || ''} ${item.license || ''} ${item.fandom || ''} ${item.boxNumber || ''} ${item.diagnosis || ''}`.toLowerCase();
        return haystack.includes(q);
      });
    }

    filterSearch.addEventListener('input', renderResults);
    filterStatus.addEventListener('change', renderResults);

    function renderResults() {
      const filtered = getFilteredProducts();

      if (productsList.length === 0) {
        emptyState.style.display = 'block';
        productCardsList.style.display = 'none';
        return;
      }

      emptyState.style.display = 'none';
      productCardsList.style.display = 'flex';
      renderProductCards(filtered);
    }

    // BUILD STANDARD PRODUCT SHEET HTML (ES or EN)
    function getProductSheetHtml(item, lang = 'es') {
