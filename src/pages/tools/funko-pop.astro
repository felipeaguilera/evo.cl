          alert('La base local está vacía. Consulta códigos para indexar figuras.');
          return;
        }
        const blob = new Blob([JSON.stringify(uniqueItems, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.setAttribute('href', url);
        link.setAttribute('download', `evo-funko-local-catalog-${new Date().toISOString().slice(0, 10)}.json`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        showToast(`Base local (${uniqueItems.length} figuras) exportada en JSON`);
      });
