    if (btnImportLocalCatalog && inputImportJson) {
      btnImportLocalCatalog.addEventListener('click', () => {
        inputImportJson.click();
      });

      inputImportJson.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (event) => {
          try {
            const data = JSON.parse(event.target.result);
            if (typeof data !== 'object' || data === null) throw new Error('Formato JSON no reconocido');

            const currentCatalog = getLocalCatalog();
            let importedCount = 0;

            const items = Array.isArray(data) ? data : Object.values(data);
            items.forEach(item => {
              if (item && item.title) {
                const cleanItem = { ...item, status: item.status || 'found', source: 'local_index' };
                if (item.query) currentCatalog[item.query] = cleanItem;
                if (item.sku) currentCatalog[item.sku] = cleanItem;
                if (item.upc) currentCatalog[item.upc] = cleanItem;
                importedCount++;
              }
            });

            localStorage.setItem(LOCAL_CATALOG_KEY, JSON.stringify(currentCatalog));
            updateLocalCatalogBadge();
            loadLocalCatalogToWorkspace();
            showToast(`¡Base importada con éxito!`);
          } catch(err) {
            alert('Error al importar archivo JSON: ' + err.message);
          } finally {
            inputImportJson.value = '';
          }
        };
        reader.readAsText(file);
      });
    }

    if (btnClearLocalCatalog) {
      btnClearLocalCatalog.addEventListener('click', () => {
        if (confirm('¿Estás seguro de que deseas vaciar el catálogo local guardado en este navegador?')) {
          localStorage.removeItem(LOCAL_CATALOG_KEY);
          updateLocalCatalogBadge();
          showToast('Base local eliminada.');
        }
      });
    }

    // UTILITY HELPERS
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function escapeAttr(str) {
      if (!str) return '';
      return String(str)
        .replace(/"/g, '&quot;')
        .replace(/\n/g, ' ');
    }

    function generateHandle(title, fallback) {
      const base = title || fallback || 'funko-pop';
      return base
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    // CLEAN INPUT CODES
    function getCleanCodes() {
      const raw = codesInput.value;
      if (!raw.trim()) return [];
      return raw
        .split(/[\r\n,;\s]+/)
        .map(c => c.trim().replace(/[^\w-]/g, ''))
        .filter(c => c.length >= 4);
    }

    function updateInputCount() {
      const count = getCleanCodes().length;
      codeCounter.textContent = `${count} ${count === 1 ? 'código' : 'códigos'}`;
    }

    codesInput.addEventListener('input', updateInputCount);

    btnLoadSample.addEventListener('click', () => {
      codesInput.value = SAMPLE_CODES.join('\n');
      updateInputCount();
      showToast(`Cargados ${SAMPLE_CODES.length} códigos de ejemplo`);
    });

    btnClearInput.addEventListener('click', () => {
      codesInput.value = '';
      updateInputCount();
    });

    function showToast(msg) {
      toastMsg.textContent = msg;
      toastNotification.classList.add('show');
      setTimeout(() => toastNotification.classList.remove('show'), 3200);
    }

    // FETCH SINGLE CODE WITH LOCAL CACHE + TIMEOUT
    async function fetchCodeWithRetry(query, forceRefresh = false, retryCount = 1) {
      // 1. Check local browser database first (instant 0ms response)
      if (!forceRefresh) {
        const cached = getFromLocalCatalog(query);
        if (cached && cached.status === 'found') {
          return { ...cached, query, source: cached.source || 'local_index', fromCache: true };
        }
      }

      const endpoints = ['/api/funko-lookup', '/.netlify/functions/funko-lookup'];
      
      for (const ep of endpoints) {
        try {
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 7000);

          const res = await fetch(ep, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query, forceRefresh }),
            signal: controller.signal
          });
          clearTimeout(timeoutId);
          
          if (res.ok) {
            const data = await res.json();
            if (data.items && data.items.length > 0) {
              const item = data.items[0];
              if (item.status === 'found') {
                saveToLocalCatalog(item);
              }
              return item;
            }
          } else if (res.status === 429 || res.status === 408) {
            if (retryCount > 0) {
              await new Promise(r => setTimeout(r, 1500));
              return fetchCodeWithRetry(query, forceRefresh, retryCount - 1);
            }
          }
        } catch (e) {
          console.warn(`[Funko Tool] Error en ${ep} para ${query}:`, e.message);
        }
      }

      const sku = query.length <= 6 ? query : (query.startsWith('889698') ? query.substring(6, 11) : '');
      let diagnosis = 'Código no indexado en catálogo comercial';
      if (query.startsWith('889698')) diagnosis = 'Vaulted / Fuera de catálogo Funko';

      return {
        query,
        upc: query.length === 12 ? query : '',
        sku,
        title: `Item #${sku || query}`,
        license: 'Funko',
        image: '',
        gallery: [],
        source: 'not_found',
        status: 'not_found',
        diagnosis
      };
    }

    // REFRESH SINGLE CARD INDIVIDUALLY ON DEMAND
    async function refreshSingleProduct(item, cardElem) {
      const q = item.query || item.sku || item.upc;
      showToast(`Refrescando datos desde la red para ${item.sku || q}...`);
      
      const refreshBtn = cardElem.querySelector('.btn-refresh-card');
      if (refreshBtn) {
        refreshBtn.classList.add('loading');
        refreshBtn.innerHTML = '<i class="ph ph-spinner ph-spin"></i> <span>Actualizando...</span>';
      }

      const updated = await fetchCodeWithRetry(q, true); // forceRefresh = true

      // Update in productsList
      const idx = productsList.findIndex(p => p.query === item.query || (p.sku && p.sku === item.sku));
      if (idx !== -1) {
        productsList[idx] = updated;
      }

      saveToLocalCatalog(updated);
      renderResults();
      showToast(`¡Ficha de ${updated.sku || q} actualizada exitosamente!`);
    }

    // BATCH QUEUE RUNNER
    async function runBatch() {
      const codes = getCleanCodes();
      if (codes.length === 0) {
        alert('Por favor ingresa al menos un código de barras o SKU.');
        return;
      }

      isRunning = true;
      isPaused = false;
      btnStart.disabled = true;
      btnPause.disabled = false;
      btnReset.disabled = false;
      codesInput.disabled = true;
      btnLoadSample.disabled = true;
      btnClearInput.disabled = true;
      reportSummaryCard.style.display = 'none';

      statusDot.className = 'status-dot active';
      statusText.textContent = 'Procesando lista...';
      progressBarFill.style.width = '0%';
      progressPercent.textContent = '0%';

      productsList = [];
      if (statTotalBadge) statTotalBadge.textContent = `(${codes.length} códigos)`;
      if (statLocal) statLocal.textContent = '0';
      statFunko.textContent = '0';
      statUpc.textContent = '0';
      statNotFound.textContent = '0';
      renderResults();

      const pacing = batchPacing ? batchPacing.value : 'fast';
      let chunkSize = 3;
      let delayMs = 200;

      if (pacing === 'moderate') {
        chunkSize = 2;
        delayMs = 400;
      } else if (pacing === 'safe') {
        chunkSize = 1;
        delayMs = 800;
      }

      let completed = 0;

      for (let i = 0; i < codes.length; i += chunkSize) {
        if (!isRunning) break;

        while (isPaused) {
          await new Promise(r => setTimeout(r, 200));
          if (!isRunning) break;
        }

        const chunk = codes.slice(i, i + chunkSize);
        statusText.textContent = `⚡ Procesando ${Math.min(i + chunkSize, codes.length)} de ${codes.length}...`;

        try {
          const results = await Promise.all(chunk.map(c => fetchCodeWithRetry(c)));

          for (const item of results) {
            productsList.push(item);
            completed++;
          }
        } catch(batchErr) {
          console.warn('Batch chunk error:', batchErr);
          chunk.forEach(c => {
            productsList.push({
              query: c,
              upc: c.length === 12 ? c : '',
              sku: c.length <= 6 ? c : '',
              title: `Item #${c}`,
              license: 'Funko',
              image: '',
              gallery: [],
              source: 'not_found',
              status: 'not_found',
              diagnosis: 'Error de conexión'
            });
            completed++;
          });
        }

        const pct = Math.round((completed / codes.length) * 100);
        progressPercent.textContent = `${pct}%`;
        progressBarFill.style.width = `${pct}%`;

        const localCount = productsList.filter(p => p.fromCache || p.source === 'local_index').length;
        const funkoCount = productsList.filter(p => p.source === 'funko_storefront').length;
        const upcCount = productsList.filter(p => p.source === 'upc_database').length;
        const notFoundCount = productsList.filter(p => p.status !== 'found').length;

        if (statLocal) statLocal.textContent = localCount;
        statFunko.textContent = funkoCount;
        statUpc.textContent = upcCount;
        statNotFound.textContent = notFoundCount;

        try {
          renderResults();
        } catch(rErr) {
          console.warn('Render error:', rErr);
        }

        if (delayMs > 0 && i + chunkSize < codes.length) {
          await new Promise(r => setTimeout(r, delayMs));
        }
      }

      isRunning = false;
      btnStart.disabled = false;
      btnPause.disabled = true;
      codesInput.disabled = false;
      btnLoadSample.disabled = false;
      btnClearInput.disabled = false;

      statusDot.className = 'status-dot';
      statusText.textContent = 'Búsqueda completada';
      showToast(`Completado: ${productsList.length} productos procesados`);

      showBatchSummary();
    }

    btnStart.addEventListener('click', runBatch);

    btnPause.addEventListener('click', () => {
      if (!isRunning) return;
      isPaused = !isPaused;
      btnPause.innerHTML = isPaused
        ? '<i class="ph ph-play" aria-hidden="true"></i><span>Reanudar</span>'
        : '<i class="ph ph-pause" aria-hidden="true"></i><span>Pausar</span>';
