      const desc = isEs ? (item.description_es || item.description || 'Figura coleccionable oficial de la marca Funko.') : (item.description || 'Official collectible figure by Funko.');
      const cleanDesc = desc
        .replace(/<br\s*\/?>/gi, ' ')
        .replace(/<\/?[^>]+(>|$)/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

      if (isEs) {
        return `
<div class="evo-product-sheet">
  <p class="sheet-desc">${escapeHtml(cleanDesc)}</p>
  <ul class="sheet-specs" style="list-style-type: none; padding-left: 0; margin-top: 1rem; line-height: 1.6;">
    ${item.license ? `<li><strong>Colección / Licencia:</strong> ${escapeHtml(item.license)}</li>` : ''}
    ${item.fandom ? `<li><strong>Fandom / Universo:</strong> ${escapeHtml(item.fandom)}</li>` : ''}
    ${item.boxNumber ? `<li><strong>Número de Caja:</strong> ${escapeHtml(item.boxNumber)}</li>` : ''}
    ${item.sku ? `<li><strong>Número de Ítem / SKU:</strong> ${escapeHtml(item.sku)}</li>` : ''}
    ${item.upc ? `<li><strong>Código de Barras (UPC):</strong> ${escapeHtml(item.upc)}</li>` : ''}
    <li><strong>Material:</strong> Vinilo de alta calidad</li>
    <li><strong>Fabricante:</strong> Funko LLC</li>
    <li><strong>Condición:</strong> Nuevo en caja original sellada</li>
  </ul>
</div>`.trim();
      }

      return `
<div class="evo-product-sheet">
  <p class="sheet-desc">${escapeHtml(cleanDesc)}</p>
  <ul class="sheet-specs" style="list-style-type: none; padding-left: 0; margin-top: 1rem; line-height: 1.6;">
    ${item.license ? `<li><strong>Collection / License:</strong> ${escapeHtml(item.license)}</li>` : ''}
    ${item.fandom ? `<li><strong>Fandom / Universe:</strong> ${escapeHtml(item.fandom)}</li>` : ''}
    ${item.boxNumber ? `<li><strong>Box Number:</strong> ${escapeHtml(item.boxNumber)}</li>` : ''}
    ${item.sku ? `<li><strong>Item Number / SKU:</strong> ${escapeHtml(item.sku)}</li>` : ''}
    ${item.upc ? `<li><strong>Barcode (UPC):</strong> ${escapeHtml(item.upc)}</li>` : ''}
    <li><strong>Material:</strong> High quality collectible vinyl</li>
    <li><strong>Manufacturer:</strong> Funko LLC</li>
    <li><strong>Condition:</strong> Brand new in original window box</li>
  </ul>
</div>`.trim();
    }

    // BUILD STANDARD PRODUCT SHEET PLAIN TEXT (ES or EN)
    function getProductSheetText(item, lang = 'es') {
      const isEs = lang === 'es';
      const desc = isEs ? (item.description_es || item.description || 'Figura coleccionable oficial de la marca Funko.') : (item.description || 'Official collectible figure by Funko.');
      const cleanDesc = desc
        .replace(/<br\s*\/?>/gi, ' ')
        .replace(/<\/?[^>]+(>|$)/g, ' ')
