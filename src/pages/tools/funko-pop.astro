---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const title = 'Funko Pop! Scraper. A tool by EVO.cl';
const description = 'Consulta masiva de figuras Funko Pop! por código de barras (UPC) o SKU. Extrae títulos oficiales, colecciones, números de caja, galerías completas de fotos y exporta directo a Shopify CSV, Tabla HTML y ZIP de fotos.';
---

<Base title={title} description={description}>
  <Nav />

  <!-- Load JSZip for client-side image ZIP generation -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

  <main class="funko-page">
    <!-- TOOL HEADER -->
    <header class="tool-header wrap">
      <p class="label" data-es="Sistemas y Herramientas" data-en="Systems & Tools">Sistemas y Herramientas</p>
      <h1 class="tool-title">Funko Pop! Catalog Scraper</h1>
      <p class="tool-desc" data-es="Consulta masiva de figuras Funko Pop! por código de barras (UPC) o SKU. Extrae títulos oficiales, colecciones, números de caja, galerías completas de fotos y exporta en formato CSV oficial para Shopify, Tabla para copiar y pegar directo en Sheets, o ZIP de fotos nombradas." data-en="Bulk Funko Pop! figure lookup by barcode (UPC) or SKU. Extracts official titles, collections, box numbers, complete photo galleries, and exports directly to official Shopify CSV, copy-paste table for Sheets, or named photos ZIP.">
        Consulta masiva de figuras Funko Pop! por código de barras (UPC) o SKU. Extrae títulos oficiales, colecciones, números de caja, galerías completas de fotos y exporta en formato CSV oficial para Shopify, Tabla para copiar y pegar directo en Sheets, o ZIP de fotos nombradas.
      </p>
    </header>

    <div class="tool-grid wrap">
      <!-- SIDEBAR CONTROLS -->
      <div class="sidebar">
        <!-- 1. INPUT CODES & PRIMARY ACTION -->
        <div class="panel-card">
          <div class="panel-card-header">
            <h2 data-es="1. Lista de Códigos" data-en="1. Code List">1. Lista de Códigos</h2>
            <span class="badge-count" id="codeCounter">0 códigos</span>
          </div>
          
          <div class="field">
            <label for="codesInput">
              <span data-es="Códigos de Barra (UPC) o SKUs" data-en="Barcodes (UPC) or SKUs">Códigos de Barra (UPC) o SKUs</span>
            </label>
            <textarea
              id="codesInput"
              class="codes-textarea"
              placeholder="889698818704&#10;889698725767&#10;889698907804&#10;95805&#10;83964"
              rows="6"
              spellcheck="false"
            ></textarea>
            <div class="help" data-es="Ingresa UPCs (12 dígitos) o SKUs (4-6 dígitos), separados por saltos de línea." data-en="Enter UPCs (12 digits) or SKUs (4-6 digits), separated by newlines.">
              Ingresa UPCs (12 dígitos) o SKUs (4-6 dígitos), separados por saltos de línea.
            </div>
          </div>

          <!-- PRIMARY ACTION BUTTONS -->
          <div style="margin-bottom: 0.75rem;">
            <button class="btn-primary btn-full" id="btnStart" type="button">
              <i class="ph ph-play" aria-hidden="true"></i>
              <span data-es="Iniciar Búsqueda" data-en="Start Search">Iniciar Búsqueda</span>
            </button>
            <div class="button-row" style="margin-top: 8px;">
              <button class="btn-compact btn-half" id="btnPause" type="button" disabled>
                <i class="ph ph-pause" aria-hidden="true"></i>
                <span data-es="Pausar" data-en="Pause">Pausar</span>
              </button>
              <button class="btn-compact btn-half" id="btnReset" type="button" disabled>
                <i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>
                <span data-es="Reiniciar" data-en="Reset">Reiniciar</span>
              </button>
            </div>
          </div>

          <!-- SAMPLE BUTTONS -->
          <div class="button-stack">
            <button class="btn-compact btn-full" id="btnLoadSample" type="button">
              <i class="ph ph-sparkle" aria-hidden="true"></i>
              <span data-es="Cargar 84 códigos de ejemplo" data-en="Load 84 sample codes">Cargar 84 códigos de ejemplo</span>
            </button>
            <button class="btn-compact btn-full" id="btnClearInput" type="button">
              <i class="ph ph-trash" aria-hidden="true"></i>
              <span data-es="Limpiar lista" data-en="Clear list">Limpiar lista</span>
            </button>
          </div>
        </div>

        <!-- 2. SEARCH SETTINGS & PACING -->
        <div class="panel-card">
          <h2 data-es="2. Ritmo de Consulta" data-en="2. Query Pacing">2. Ritmo de Consulta</h2>
          <div class="field">
            <label for="batchPacing">
              <span data-es="Velocidad de Lote" data-en="Batch Speed">Velocidad de Lote</span>
            </label>
            <select id="batchPacing">
              <option value="fast" selected data-es="Rápida y Concurrente (3 req / 200ms — Recomendada)" data-en="Fast & Concurrent (3 req / 200ms — Recommended)">Rápida y Concurrente (3 req / 200ms — Recomendada)</option>
              <option value="moderate" data-es="Moderada (2 req / 400ms)" data-en="Moderate (2 req / 400ms)">Moderada (2 req / 400ms)</option>
              <option value="safe" data-es="Estable (1 req / 800ms)" data-en="Stable (1 req / 800ms)">Estable (1 req / 800ms)</option>
            </select>
            <div class="help" data-es="Evita bloqueos de cuota o time-outs al consultar grandes lotes." data-en="Prevents rate limiting or time-outs when querying large batches.">
              Evita bloqueos de cuota o time-outs al consultar grandes lotes.
            </div>
          </div>
        </div>

        <!-- 3. LOCAL PERSISTENT INDEX -->
        <div class="panel-card">
          <div class="panel-card-header">
            <h2 data-es="3. Índice Local EVO" data-en="3. EVO Local Index">3. Índice Local EVO</h2>
            <span class="badge-count" id="localCatalogBadge">0 figuras</span>
          </div>
          <p class="help" style="margin-bottom: 0.85rem;" data-es="Las figuras consultadas se guardan de forma permanente para responder en 0ms y no gastar cuotas de red." data-en="Queried figures are stored permanently for 0ms responses and zero network quotas.">
            Las figuras consultadas se guardan de forma permanente para responder en 0ms y no gastar cuotas de red.
          </p>
          <div class="button-stack">
            <button class="btn-compact btn-full btn-accent" id="btnLoadLocalCatalog" type="button" title="Cargar todas las figuras guardadas en la pantalla activa para ver fichas y re-exportar">
              <i class="ph ph-database" aria-hidden="true"></i>
              <span data-es="Cargar Catálogo en Pantalla" data-en="Load Catalog to Workspace">Cargar Catálogo en Pantalla</span>
            </button>
            <div class="button-row">
              <button class="btn-compact btn-half" id="btnExportLocalCatalog" type="button" title="Descargar copia de seguridad de la base local en formato JSON">
                <i class="ph ph-download-simple" aria-hidden="true"></i>
                <span data-es="Exportar (JSON)" data-en="Export (JSON)">Exportar (JSON)</span>
              </button>
              <button class="btn-compact btn-half" id="btnImportLocalCatalog" type="button" title="Importar copia de respaldo en formato JSON">
                <i class="ph ph-upload-simple" aria-hidden="true"></i>
                <span data-es="Importar (JSON)" data-en="Import (JSON)">Importar (JSON)</span>
              </button>
              <input type="file" id="inputImportJson" accept=".json,application/json" style="display:none;" />
            </div>
            <button class="btn-compact btn-full" id="btnClearLocalCatalog" type="button" title="Vaciar la memoria local para reiniciar búsquedas limpias">
              <i class="ph ph-trash" aria-hidden="true"></i>
              <span data-es="Limpiar Base Local" data-en="Clear Local Index">Limpiar Base Local</span>
            </button>
          </div>
        </div>
      </div>

      <!-- MAIN WORKSPACE -->
      <div class="workspace-area">
        <!-- PROGRESS & METRICS -->
        <div class="panel-card metrics-card">
          <div class="progress-header">
            <div class="status-indicator">
              <span class="status-dot" id="statusDot"></span>
              <span id="statusText" data-es="Listo para iniciar" data-en="Ready to start">Listo para iniciar</span>
            </div>
            <div class="progress-right-wrap">
              <span class="progress-percent" id="progressPercent">0%</span>
              <span class="progress-total-badge" id="statTotalBadge">(0 códigos)</span>
            </div>
          </div>

          <!-- PROMINENT PROGRESS BAR -->
          <div class="progress-bar-track">
            <div class="progress-bar-fill" id="progressBarFill" style="width: 0%;"></div>
          </div>

          <!-- STATS GRID (BALANCED 4-CARD DASHBOARD) -->
          <div class="stats-grid stats-grid-4">
            <div class="stat-card">
              <span class="stat-label" data-es="Índice Local (0ms)" data-en="Local Index (0ms)">Índice Local (0ms)</span>
              <span class="stat-num text-teal" id="statLocal">0</span>
            </div>
            <div class="stat-card">
              <span class="stat-label" data-es="Funko US (Oficial)" data-en="Funko US (Official)">Funko US (Oficial)</span>
              <span class="stat-num text-primary" id="statFunko">0</span>
            </div>
            <div class="stat-card">
              <span class="stat-label" data-es="Índice UPC / Dist." data-en="UPC Index / Dist.">Índice UPC / Dist.</span>
              <span class="stat-num text-success" id="statUpc">0</span>
            </div>
            <div class="stat-card">
              <span class="stat-label" data-es="No Encontrados" data-en="Not Found">No Encontrados</span>
              <span class="stat-num text-warning" id="statNotFound">0</span>
            </div>
          </div>
        </div>

        <!-- VIEW MODE TABS (PERMANENTLY AT THE TOP) -->
        <div class="view-mode-tabs-bar" id="viewModeTabsBar" style="display: none;">
          <div class="view-tabs-group">
            <button class="view-tab-btn active" id="tabViewCards" type="button">
              <i class="ph ph-squares-four"></i> <span>Listado de Figuras</span>
            </button>
            <button class="view-tab-btn" id="tabViewCollections" type="button">
              <i class="ph ph-folders"></i> <span id="tabCollectionsLabel">Colecciones (0)</span>
            </button>
          </div>
        </div>

        <!-- POST-BATCH REPORT SUMMARY (VISUAL COLLECTIONS BREAKDOWN) -->
        <div class="panel-card report-summary-card" id="reportSummaryCard" style="display: none;">
          <div class="report-header">
            <div class="report-title-wrap">
              <div class="report-icon-badge">
                <i class="ph ph-squares-four"></i>
              </div>
              <div>
                <h3 data-es="Colecciones y Figuras Identificadas" data-en="Identified Collections & Figures">Colecciones y Figuras Identificadas</h3>
                <p id="reportSummarySubtitle">Desglose agrupado por licencias del lote consultado. Haz clic en una para filtrar.</p>
              </div>
            </div>

            <!-- ONE-CLICK EXPORT ACTIONS -->
            <div class="report-actions">
              <button class="btn-compact btn-accent" id="btnReportExportShopifyEs" type="button" title="Descargar archivo CSV estructurado con descripciones en Español para Shopify">
                <i class="ph ph-shopify-logo"></i>
                <span data-es="CSV Shopify (ES)" data-en="Shopify CSV (ES)">CSV Shopify (ES)</span>
              </button>
              <button class="btn-compact btn-secondary-accent" id="btnReportCopyHtml" type="button" title="Copiar tabla para pegar directo con Ctrl+V en Google Sheets, Word o Notion">
                <i class="ph ph-copy"></i>
                <span data-es="Copiar Tabla (Sheets)" data-en="Copy Table (Sheets)">Copiar Tabla (Sheets)</span>
              </button>
              <button class="btn-compact" id="btnReportExportZip" type="button" title="Descargar paquete ZIP con fotos nombradas por SKU">
                <i class="ph ph-file-zip"></i>
                <span data-es="ZIP Fotos (SKU)" data-en="Photos ZIP (SKU)">ZIP Fotos (SKU)</span>
              </button>
            </div>
          </div>
          
          <!-- COLLECTIONS GRID -->
          <div class="collections-grid" id="reportCollectionsGrid"></div>
        </div>

        <!-- TOOLBAR & FILTERS -->
        <div class="results-toolbar">
          <div class="filter-group">
            <div class="search-input-wrap">
              <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
              <input
                type="text"
                id="filterSearch"
                placeholder="Filtrar por título, licencia, caja..."
                data-es-ph="Filtrar por título, licencia, caja..."
                data-en-ph="Filter by title, license, box number..."
              />
            </div>

            <select id="filterStatus" class="select-compact">
              <option value="all" data-es="Todos los estados" data-en="All statuses">Todos los estados</option>
              <option value="found" data-es="Solo encontrados" data-en="Only found">Solo encontrados</option>
              <option value="not_found" data-es="Solo no encontrados" data-en="Only not found">Solo no encontrados</option>
            </select>
          </div>

          <div class="actions-group">
            <!-- EXPORT BUTTONS -->
            <div class="export-dropdown-wrap">
              <button class="btn-compact btn-accent" id="btnExportShopify" type="button" title="CSV listo para importar directo a Shopify (Descripciones en Español)">
                <i class="ph ph-shopify-logo" aria-hidden="true"></i>
                <span data-es="CSV Shopify (ES)" data-en="Shopify CSV (ES)">CSV Shopify (ES)</span>
              </button>
              <button class="btn-compact" id="btnExportShopifyEn" type="button" title="CSV con descripciones originales en Inglés">
                <i class="ph ph-globe" aria-hidden="true"></i>
                <span>CSV (EN)</span>
              </button>
              <button class="btn-compact" id="btnCopyHtmlTable" type="button" title="Copiar tabla para pegar con Ctrl+V en Google Sheets">
                <i class="ph ph-copy" aria-hidden="true"></i>
                <span data-es="Copiar Tabla" data-en="Copy Table">Copiar Tabla</span>
              </button>
              <button class="btn-compact" id="btnExportZip" type="button" title="Descargar paquete ZIP con todas las fotos de lote">
                <i class="ph ph-file-zip" aria-hidden="true"></i>
                <span data-es="ZIP Todas las Fotos" data-en="ZIP All Photos">ZIP Lote</span>
              </button>
              <button class="btn-compact" id="btnExportCsv" type="button" title="CSV general con todas las URLs">
                <i class="ph ph-file-csv" aria-hidden="true"></i>
                <span data-es="CSV General" data-en="General CSV">CSV</span>
              </button>
            </div>
          </div>
        </div>

        <!-- RESULTS CONTAINER -->
        <div class="results-container">
          <!-- EMPTY STATE -->
          <div class="panel-card empty-state" id="emptyState">
            <div class="empty-icon-wrap">
              <i class="ph ph-barcode" aria-hidden="true"></i>
            </div>
            <h3 data-es="Sin productos consultados" data-en="No products queried yet">Sin productos consultados</h3>
            <p data-es="Ingresa una lista de códigos en el panel lateral o presiona 'Cargar 84 códigos de ejemplo'." data-en="Enter a list of codes on the sidebar or click 'Load 84 sample codes'.">
              Ingresa una lista de códigos en el panel lateral o presiona 'Cargar 84 códigos de ejemplo'.
            </p>
          </div>

          <!-- 2-STAGE PRODUCT CARDS LIST (DEFAULT GALLERY + EXPANDABLE FICHA) -->
          <div class="product-cards-list" id="productCardsList" style="display:none;"></div>
        </div>
      </div>
    </div>

    <!-- ZIP PROGRESS MODAL -->
    <div class="modal-overlay" id="zipProgressModal" style="display:none;">
      <div class="modal-card zip-modal-card">
        <h3 style="margin-top:0; font-family:'Inter',sans-serif; font-size:1.15rem;" data-es="Generando Archivo ZIP..." data-en="Generating ZIP File...">Generando Archivo ZIP...</h3>
        <p id="zipProgressText" style="font-size:0.875rem; color:var(--text-2); margin-bottom:1rem;">Descargando fotografías en alta resolución...</p>
        <div class="progress-bar-track">
          <div class="progress-bar-fill" id="zipProgressFill" style="width:0%;"></div>
        </div>
      </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div class="toast" id="toastNotification">
      <i class="ph ph-check-circle" id="toastIcon"></i>
      <span id="toastMsg">Acción completada</span>
    </div>
  </main>

  <Footer />

  <script is:inline>
    // SAMPLE BARCODES FROM USER BRIEF
    const SAMPLE_CODES = [
      "889698725767", "889698725774", "889698725781", "889698725798",
      "889698725804", "889698725811", "889698725828", "889698725699",
      "889698725705", "889698725712", "889698725729", "889698725736",
      "889698725743", "889698725750", "889698907804", "889698901451",
      "889698901468", "889698901475", "889698906432", "889698839648",
      "889698844499", "889698903417", "889698944120", "889698944137",
      "889698932066", "889698932059", "889698932042", "889698928687",
      "889698928694", "889698928700", "889698932776", "889698932783",
      "889698932790", "889698932806", "889698936897", "889698951302",
      "889698929561", "889698929578", "889698929585", "889698929592",
      "889698923064", "889698935661", "889698930178", "889698863681",
      "889698932295", "889698933964", "889698933858", "889698933865",
      "889698941440", "889698932745", "889698932752", "889698932769",
      "889698922753", "889698922760", "889698922791", "889698922777",
      "889698928816", "889698928823", "889698828830", "889698928847",
      "889698940498", "889698940481", "889698940030", "889698920339",
      "889698920346", "889698940306", "889698941716", "889698939959",
      "889698925938", "889698925945", "889698939317", "889698939294",
      "889698939348", "889698920377", "889698907972", "889698941099",
      "889698855334", "889698906678", "889698657921", "849803039912",
      "889698881500", "889698836869", "889698722360", "889698818704"
    ];

    // STATE
    let productsList = [];
    let isRunning = false;
    let isPaused = false;
    const expandedProductIds = new Set();

    // DOM ELEMENTS
    const codesInput = document.getElementById('codesInput');
    const codeCounter = document.getElementById('codeCounter');
    const btnLoadSample = document.getElementById('btnLoadSample');
    const btnClearInput = document.getElementById('btnClearInput');
    const btnStart = document.getElementById('btnStart');
    const btnPause = document.getElementById('btnPause');
    const btnReset = document.getElementById('btnReset');
    const batchPacing = document.getElementById('batchPacing');

    const statusDot = document.getElementById('statusDot');
    const statusText = document.getElementById('statusText');
    const progressPercent = document.getElementById('progressPercent');
    const progressBarFill = document.getElementById('progressBarFill');
    const statTotalBadge = document.getElementById('statTotalBadge');
    const statLocal = document.getElementById('statLocal');
    const statFunko = document.getElementById('statFunko');
    const statUpc = document.getElementById('statUpc');
    const statNotFound = document.getElementById('statNotFound');

    const viewModeTabsBar = document.getElementById('viewModeTabsBar');
    const tabViewCards = document.getElementById('tabViewCards');
    const tabViewCollections = document.getElementById('tabViewCollections');
    const tabCollectionsLabel = document.getElementById('tabCollectionsLabel');

    const localCatalogBadge = document.getElementById('localCatalogBadge');
    const btnLoadLocalCatalog = document.getElementById('btnLoadLocalCatalog');
    const btnExportLocalCatalog = document.getElementById('btnExportLocalCatalog');
    const btnImportLocalCatalog = document.getElementById('btnImportLocalCatalog');
    const inputImportJson = document.getElementById('inputImportJson');
    const btnClearLocalCatalog = document.getElementById('btnClearLocalCatalog');

    const reportSummaryCard = document.getElementById('reportSummaryCard');
    const reportSummarySubtitle = document.getElementById('reportSummarySubtitle');
    const reportCollectionsGrid = document.getElementById('reportCollectionsGrid');
    const btnReportExportShopifyEs = document.getElementById('btnReportExportShopifyEs');
    const btnReportCopyHtml = document.getElementById('btnReportCopyHtml');
    const btnReportExportZip = document.getElementById('btnReportExportZip');

    const filterSearch = document.getElementById('filterSearch');
    const filterStatus = document.getElementById('filterStatus');
    const btnExportShopify = document.getElementById('btnExportShopify');
    const btnExportShopifyEn = document.getElementById('btnExportShopifyEn');
    const btnCopyHtmlTable = document.getElementById('btnCopyHtmlTable');
    const btnExportZip = document.getElementById('btnExportZip');
    const btnExportCsv = document.getElementById('btnExportCsv');

    const emptyState = document.getElementById('emptyState');
    const productCardsList = document.getElementById('productCardsList');

    const zipProgressModal = document.getElementById('zipProgressModal');
    const zipProgressText = document.getElementById('zipProgressText');
    const zipProgressFill = document.getElementById('zipProgressFill');

    const toastNotification = document.getElementById('toastNotification');
    const toastMsg = document.getElementById('toastMsg');

    // =======================================================
    // LOCAL CATALOG STORAGE SYSTEM (PERSISTENT CLIENT-SIDE INDEX)
    // =======================================================
    const LOCAL_CATALOG_KEY = 'evo_funko_local_catalog_v1';

    function getLocalCatalog() {
      try {
        const raw = localStorage.getItem(LOCAL_CATALOG_KEY);
        return raw ? JSON.parse(raw) : {};
      } catch (e) {
        return {};
      }
    }

    function getUniqueLocalFigures() {
      const catalog = getLocalCatalog();
      const map = new Map();
      Object.values(catalog).forEach(item => {
        if (!item || !item.title) return;
        const key = item.sku || item.upc || item.query || item.title;
        if (!map.has(key)) {
          map.set(key, item);
        }
      });
      return Array.from(map.values());
    }

    function saveToLocalCatalog(item) {
      if (!item || item.status !== 'found') return;
      try {
        const catalog = getLocalCatalog();
        const cleanItem = { ...item, source: item.source || 'local_index' };
        if (item.query) catalog[item.query] = cleanItem;
        if (item.sku) catalog[item.sku] = cleanItem;
        if (item.upc) catalog[item.upc] = cleanItem;
        localStorage.setItem(LOCAL_CATALOG_KEY, JSON.stringify(catalog));
        updateLocalCatalogBadge();
      } catch (e) {
        console.warn('Error saving to local catalog:', e);
      }
    }

    function getFromLocalCatalog(query) {
      if (!query) return null;
      const catalog = getLocalCatalog();
      return catalog[query] || null;
    }

    function updateLocalCatalogBadge() {
      const uniqueFigures = getUniqueLocalFigures();
      const count = uniqueFigures.length;
      if (localCatalogBadge) {
        localCatalogBadge.textContent = `${count} ${count === 1 ? 'figura' : 'figuras'}`;
      }
    }

    function loadLocalCatalogToWorkspace() {
      const uniqueItems = getUniqueLocalFigures();
      if (uniqueItems.length === 0) {
        alert('No hay figuras guardadas en la base local todavía. Realiza una búsqueda primero.');
        return;
      }

      // Populate input textarea with the codes
      const codes = uniqueItems.map(item => item.sku || item.upc || item.query).filter(Boolean);
      codesInput.value = codes.join('\n');
      updateInputCount();

      // Set active productsList directly with all locally indexed figures
      productsList = uniqueItems.map(item => ({
        ...item,
        source: item.source || 'local_index',
        fromCache: true,
        status: 'found'
      }));

      // Update button states: Search is not needed, it's ALREADY loaded!
      btnStart.style.display = 'none';
      btnPause.style.display = 'none';
      btnReset.style.display = 'inline-flex';
      btnReset.disabled = false;
      codesInput.disabled = false;

      // Update metrics
      progressBarFill.style.width = '100%';
      progressPercent.textContent = '100%';
      if (statTotalBadge) statTotalBadge.textContent = `(${productsList.length} códigos)`;
      if (statLocal) statLocal.textContent = String(productsList.length);

      const bySource = { funko_storefront: 0, upc_database: 0, not_found: 0, other: 0 };
      uniqueItems.forEach(item => {
        const key = bySource.hasOwnProperty(item.source) ? item.source : 'other';
        bySource[key]++;
      });
      statFunko.textContent = String(bySource.funko_storefront);
      statUpc.textContent = String(bySource.upc_database);
